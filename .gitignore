# Database dumps & SQL files
database/

# Environment / secrets
.env
.env.prod
.env.backup
.env.local
.env.*.local

# PHP dependencies (run: composer install)
vendor/

# Login sessions — keep the folder guard, ignore the session files
core/sessions/*
!core/sessions/.htaccess

# One-time audit clock correction marker (created on the server)
core/logs/audit/.mur_shift_done

# Runtime logs — keep core/logs/.htaccess but ignore log files
core/logs/security/
*.log
callback/**/log.txt
callback/**/log.txt.old
callback/**/webhook_log.txt
callback/**/webhook_log.txt.old

